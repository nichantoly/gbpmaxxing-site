Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Keep the git folder private when the site is deployed from GitHub
RedirectMatch 404 /\.git

<IfModule mod_rewrite.c>
RewriteEngine On
# One canonical origin: https and no www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://gbpmaxxing.com/$1 [R=301,L]
</IfModule>

AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2
AddType image/webp .webp
AddType text/javascript .js

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

# The PDFs point search engines at the page that describes them
<FilesMatch "^GBP-MAXXING-v1\.4\.pdf$">
Header set Link "<https://gbpmaxxing.com/>; rel=canonical"
</FilesMatch>
<FilesMatch "^GBP-MAXXING-v1\.4-Appraisers-Edition\.pdf$">
Header set Link "<https://gbpmaxxing.com/appraisers/>; rel=canonical"
</FilesMatch>

<FilesMatch "\.(css|js|woff2)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(webp|jpg|png|svg|ico)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
<FilesMatch "\.pdf$">
Header set Cache-Control "public, max-age=3600"
</FilesMatch>
<FilesMatch "\.(html|xml|txt|webmanifest)$">
Header set Cache-Control "public, max-age=0, must-revalidate"
</FilesMatch>
</IfModule>
